#!/bin/bash
# Mock slangc compiler

# Find the output file path from the arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -o) output_file="$2"; shift ;;
    esac
    shift
done

if [[ -z "$output_file" ]]; then
    echo "Mock slangc: -o flag not found" >&2
    exit 1
fi

# Write a dummy GLSL fragment shader to the output file
cat > "$output_file" <<EOL
#version 450
layout(location = 0) in vec2 v_tex;
layout(location = 0) out vec4 FragColor;
uniform sampler2D Source;

// Uniform block that matches the python script
layout(std140, binding = 0) uniform UBO
{
    mat4 MVP;
    vec4 OutputSize;
    vec4 OriginalSize;
    vec4 SourceSize;
};

void main()
{
    // Just sample the input texture and output it.
    // This allows testing the pipeline without a complex shader.
    FragColor = texture(Source, v_tex);
}
EOL

exit 0
