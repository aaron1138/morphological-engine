#version 430 core

// Define the size of the workgroup
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// This shader reads from one 3D texture and writes the inverted value to another.
// Using coherent memory access and image load/store for direct read/write.
// 'r32f' specifies a single-component 32-bit float texture.

// Input data (read-only)
layout (binding = 0, r32f) uniform readonly image3D input_texture;

// Output data (write-only)
layout (binding = 1, r32f) uniform writeonly image3D output_texture;

void main() {
    // Get the global 3D coordinate of the current thread
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);

    // Read the voxel value from the input texture at the given coordinate
    float voxel_value = imageLoad(input_texture, coord).r;

    // Invert the value
    float inverted_value = 1.0 - voxel_value;

    // Write the inverted value to the output texture at the same coordinate
    imageStore(output_texture, coord, vec4(inverted_value, 0.0, 0.0, 0.0));
}
